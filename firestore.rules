rules_version = '2';

// Solo il proprietario (un unico account email/password) può leggere e scrivere.
// Sostituisci PASTE_YOUR_UID con l'UID mostrato in Settings → Cloud sync dopo il primo accesso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == "PASTE_YOUR_UID";
    }
  }
}
